{
  "name": "franchiseguide-suite",
  "version": "0.36.0",
  "private": true,
  "description": "FranchiseGuide QA dependencies; production Web and local server have no npm dependencies.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:dom": "node --test tests/web-dom-v014.test.cjs tests/retro-orchestration-v014.test.cjs",
    "start": "node server/start.cjs",
    "sync:web": "node tools/sync_web.cjs",
    "build:pc": "bash tools/build_pc.sh",
    "test:browser": "node tests/browser-origin.cjs",
    "check:structure": "python3 tools/validate_project.py"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.2",
    "jsdom": "26.1.0",
    "playwright": "1.62.1"
  }
}
